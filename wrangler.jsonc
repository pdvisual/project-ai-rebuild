{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "projectai-rebuild-test",
  "main": "worker.js",
  "compatibility_date": "2026-11-12",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "project-ai-db",
      "database_id": "db46b24c-2a31-4703-9708-a794008ca522",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "invocation_logs": true,
      "head_sampling_rate": 1
    }
  }
}
